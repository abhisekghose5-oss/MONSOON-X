# MONSOON-X (MX-DSS) Environment Configuration
# SIH26086: Hyperlocal Monsoon Onset & Break Prediction System

# Backend API microservice base URL
VITE_API_BASE_URL=http://localhost:8000

# GeoServer / Mapbox / Carto tile endpoint for GIS raster and vector layers
VITE_GIS_TILE_SERVER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Ingestion telemetry refresh interval in milliseconds (default: 3 minutes)
VITE_TELEMETRY_POLL_INTERVAL_MS=180000
